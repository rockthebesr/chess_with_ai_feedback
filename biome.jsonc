{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["server/**", "src/**", "shared/**", "tests/**", "*.ts", "!src/styles.css", "!server/data"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "a11y": {
        // There are no forms, so a button's default type can't submit anything.
        "useButtonType": "off"
      },
      "correctness": {
        // Effects here deliberately list values that trigger a refetch without being read inside.
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // Codex App Server responses are untyped JSON-RPC.
      "includes": ["server/coach.ts"],
      "linter": { "rules": { "suspicious": { "noExplicitAny": "off" } } }
    }
  ]
}
